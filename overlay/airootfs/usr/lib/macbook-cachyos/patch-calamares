#!/usr/bin/env bash
set -Eeuo pipefail

CALAMARES_ROOT="${MACBOOK_CALAMARES_ROOT:-}"
PACSTRAP="$CALAMARES_ROOT/etc/calamares/modules/pacstrap.conf"
SERVICES="$CALAMARES_ROOT/etc/calamares/modules/services-systemd.conf"

for config in "$PACSTRAP" "$SERVICES"; do
  if [[ ! -f "$config" ]]; then
    echo "Missing expected CachyOS Calamares configuration: $config" >&2
    exit 1
  fi
done

insert_before() {
  local config="${1:?missing configuration}"
  local anchor="${2:?missing anchor}"
  local marker="${3:?missing marker}"
  local block="${4:?missing block}"
  local temp

  if grep -qxF "$marker" "$config"; then
    return 0
  fi
  if [[ "$(grep -cxF "$anchor" "$config")" -ne 1 ]]; then
    echo "Expected exactly one '$anchor' in $config; refusing to patch it." >&2
    exit 1
  fi

  temp="$(mktemp "${config}.XXXXXX")"
  : > "$temp"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$anchor" ]]; then
      printf '%s\n' "$block" >> "$temp"
    fi
    printf '%s\n' "$line" >> "$temp"
  done < "$config"
  chmod 0644 "$temp"
  mv -f -- "$temp" "$config"
}

insert_after() {
  local config="${1:?missing configuration}"
  local anchor="${2:?missing anchor}"
  local marker="${3:?missing marker}"
  local block="${4:?missing block}"
  local temp

  if grep -qxF "$marker" "$config"; then
    return 0
  fi
  if [[ "$(grep -cxF "$anchor" "$config")" -ne 1 ]]; then
    echo "Expected exactly one '$anchor' in $config; refusing to patch it." >&2
    exit 1
  fi

  temp="$(mktemp "${config}.XXXXXX")"
  : > "$temp"
  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line" >> "$temp"
    if [[ "$line" == "$anchor" ]]; then
      printf '%s\n' "$block" >> "$temp"
    fi
  done < "$config"
  chmod 0644 "$temp"
  mv -f -- "$temp" "$config"
}

