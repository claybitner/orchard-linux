#!/usr/bin/env bash
set -Eeuo pipefail

STATE_DIR=/var/lib/macbook-cachyos
mkdir -p "$STATE_DIR"

product="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)"

{
  echo "date=$(date --iso-8601=seconds)"
  echo "vendor=$vendor"
  echo "product=$product"
} > "$STATE_DIR/hardware"

# Require both Apple firmware identification and a MacBook product identifier.
# A non-Apple machine with an unusual product string must remain untouched.
if [[ "$vendor" != "Apple Inc." || "$product" != MacBook* ]]; then
  echo "Not Apple MacBook hardware; leaving generic defaults in place."
  touch "$STATE_DIR/complete"
  exit 0
fi

systemctl enable --now NetworkManager.service 2>/dev/null || true
systemctl enable --now bluetooth.service 2>/dev/null || true
systemctl enable --now thermald.service 2>/dev/null || true
systemctl enable --now power-profiles-daemon.service 2>/dev/null || true
systemctl enable --now fstrim.timer 2>/dev/null || true

# Broadcom vendor ID 14e4. Let the packaged driver's PCI aliases decide
# whether wl supports the detected runtime device; do not unload alternatives.
if lspci -Dn | grep -qi '^.* 0280: 14e4:'; then
  modprobe wl 2>/dev/null || true
fi

# Install Plasma defaults for existing human users, and retain the script for
# future users. This is intentionally best-effort.
while IFS=: read -r user _ uid _ _ home shell; do
  if (( uid >= 1000 && uid < 60000 )) && [[ -d "$home" ]] && [[ "$shell" != */nologin ]]; then
    group="$(id -gn "$user")"
    install -d -o "$user" -g "$group" "$home/.local/share/macbook-cachyos"
    install -m 0755 -o "$user" -g "$group" \
      /usr/lib/macbook-cachyos/setup-plasma \
      "$home/.local/share/macbook-cachyos/setup-plasma"
    sudo -u "$user" /usr/lib/macbook-cachyos/setup-plasma "$home" || true
  fi
done < /etc/passwd

macbook-hardware-report > "$STATE_DIR/report.txt" 2>&1 || true
macbook-diagnostic-bundle "$STATE_DIR/diagnostics.tar.gz" >/dev/null 2>&1 || true
touch "$STATE_DIR/complete"
